{
  "name": "obsidian-ontologize",
  "version": "0.4.1",
  "description": "Local-first ontology, inheritance-aware querying, validation, and relation maintenance for Obsidian Markdown vaults.",
  "keywords": [
    "obsidian",
    "plugin",
    "ontology",
    "markdown",
    "knowledge-graph"
  ],
  "license": "MIT",
  "author": "112345brian",
  "type": "module",
  "scripts": {
    "build": "jiti scripts/build.ts",
    "build:clean": "jiti scripts/build-clean.ts",
    "build:compile": "jiti scripts/build-compile.ts",
    "dev": "jiti scripts/dev.ts",
    "format": "jiti scripts/format.ts",
    "format:check": "jiti scripts/format-check.ts",
    "lint": "jiti scripts/lint.ts",
    "lint:fix": "jiti scripts/lint-fix.ts",
    "prepare": "jiti scripts/prepare.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:versions": "jiti scripts/version-check.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:versions && npm run build",
    "test:watch": "vitest",
    "bump": "release-it",
    "release": "release-it"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}",
      "requireCleanWorkingDir": true
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": "npm run check",
      "after:bump": [
        "jiti scripts/sync-obsidian-manifest.ts",
        "towncrier build --yes --version ${version}"
      ]
    }
  },
  "devDependencies": {
    "@codemirror/language": "6.11.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@commitlint/types": "20.0.0",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "25.0.3",
    "@typescript-eslint/utils": "8.60.1",
    "cspell": "10.0.1",
    "dprint": "0.55.2",
    "esbuild": "0.28.1",
    "eslint": "10.4.1",
    "jiti": "2.7.0",
    "markdownlint": "0.41.1",
    "markdownlint-cli2": "0.23.1",
    "markdownlint-rule-relative-links": "5.1.0",
    "moment": "2.29.4",
    "obsidian": "1.13.0",
    "obsidian-dev-utils": "87.3.0",
    "obsidian-typings": "6.25.0",
    "release-it": "20.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.8",
    "yaml": "2.9.0"
  },
  "overrides": {
    "boolean": "npm:dry-uninstall",
    "dompurify": "3.2.4",
    "type-fest": "latest"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
